{
  "name": "your-daily-phill.github.io",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run generate:blog && ng serve",
    "build": "npm run generate:blog && ng build",
    "build:gh-pages": "npm run generate:blog && ng build --configuration production --output-mode=static --base-href / && node scripts/copy-404.mjs",
    "generate:blog": "node scripts/generate-blog.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:yourDailyPhill.github.io": "node dist/your-daily-phill.github.io/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.23",
    "@angular/compiler": "^20.3.23",
    "@angular/core": "^20.3.23",
    "@angular/forms": "^20.3.23",
    "@angular/platform-browser": "^20.3.23",
    "@angular/platform-browser-dynamic": "^20.3.23",
    "@angular/platform-server": "^20.3.23",
    "@angular/router": "^20.3.23",
    "@angular/ssr": "^20.3.26",
    "express": "^4.18.2",
    "marked": "^18.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^20.0.0",
    "@angular-devkit/build-angular": "^20.3.26",
    "@angular/cli": "^20.3.26",
    "@angular/compiler-cli": "^20.3.23",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^18.18.0",
    "gray-matter": "^4.0.3",
    "jest": "^29.7.0",
    "typescript": "~5.9.3"
  }
}
