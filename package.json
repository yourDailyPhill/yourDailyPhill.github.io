{
  "name": "your-daily-phill.github.io",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run generate:blog && ng serve",
    "build": "npm run generate:blog && ng build",
    "build:gh-pages": "npm run generate:blog && ng build --configuration production --output-mode=static --base-href / && node scripts/copy-404.mjs",
    "generate:blog": "node scripts/generate-blog.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:yourDailyPhill.github.io": "node dist/your-daily-phill.github.io/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "express": "^4.18.2",
    "marked": "^18.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^22.0.1",
    "@angular-devkit/build-angular": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.20.1",
    "gray-matter": "^4.0.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true
  }
}
